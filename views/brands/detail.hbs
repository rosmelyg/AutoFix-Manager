<div class="container-fluid pt-2">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h4 class="card-title fw-bold mb-0 text-dark">
                <i class="fa-solid fa-copyright text-orange me-2"></i>Detalle de la Marca
            </h4>
            <div>
                <a href="/brands/edit/{{brand.id}}" class="btn btn-sm btn-outline-primary me-2">
                    <i class="fa-solid fa-pen-to-square me-1"></i> Editar
                </a>
                <a href="/brands" class="btn btn-sm btn-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Nombre</label>
                    <p class="fs-5 fw-bold text-dark mb-0">{{brand.name}}</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">País de Origen</label>
                    <p class="fs-5 text-dark mb-0">
                        {{#if brand.originCountry}}{{brand.originCountry}}{{else}}<span class="text-muted">No registrado</span>{{/if}}
                    </p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Estado</label>
                    <div>
                        {{#if (eq brand.status 'Activa')}}
                            <span class="badge bg-success fs-6">Activa</span>
                        {{else}}
                            <span class="badge bg-secondary fs-6">Inactiva</span>
                        {{/if}}
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Vehículos Asociados</label>
                    <p class="fs-5 fw-bold text-dark mb-0">{{brand.vehicleCount}}</p>
                </div>
            </div>
        </div>
    </div>

    {{#if brand.Vehicles.length}}
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Vehículos de esta Marca</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Placa</th>
                            <th>Modelo</th>
                            <th>Año</th>
                            <th>Color</th>
                            <th>Estado</th>
                            <th class="text-end pe-3">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each brand.Vehicles}}
                        <tr>
                            <td class="ps-3 fw-bold">{{this.plate}}</td>
                            <td>{{this.model}}</td>
                            <td>{{this.year}}</td>
                            <td>{{this.color}}</td>
                            <td><span class="badge bg-info text-dark">{{this.status}}</span></td>
                            <td class="text-end pe-3">
                                <a href="/vehicles/detail/{{this.id}}" class="btn btn-sm btn-outline-info">
                                    <i class="fa-solid fa-eye"></i> Ver
                                </a>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/if}}
</div>
