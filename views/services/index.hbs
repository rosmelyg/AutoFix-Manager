<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-toolbox text-orange me-2"></i>Gestión de Servicios</h2>
            <p class="text-muted mb-0">Administra el catálogo de servicios y mantenimientos ofrecidos por el taller.</p>
        </div>
        <a href="/services/create" class="btn btn-orange px-4 py-2">
            <i class="fa-solid fa-plus me-1"></i> Registrar Servicio
        </a>
    </div>

    {{#if success}}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>{{success}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {{/if}}

    {{#if error}}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>{{error}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {{/if}}

    <!-- Filtros -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form action="/services" method="GET" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-muted">Filtrar por Categoría</label>
                    <select name="category" class="form-select form-select-sm">
                        <option value="">Todas las categorías</option>
                        {{#each categories}}
                            <option value="{{this}}" {{#if (eq ../filters.category this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-muted">Filtrar por Estado</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">Todos los estados</option>
                        {{#each statuses}}
                            <option value="{{this}}" {{#if (eq ../filters.status this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-dark w-100">
                        <i class="fa-solid fa-filter me-1"></i> Filtrar
                    </button>
                    <a href="/services" class="btn btn-sm btn-outline-secondary" title="Limpiar Filtros">
                        <i class="fa-solid fa-arrows-rotate"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nombre del Servicio</th>
                            <th>Categoría</th>
                            <th>Precio Base</th>
                            <th>Duración Estimada</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each services}}
                        <tr>
                            <td class="ps-4 fw-bold">{{this.name}}</td>
                            <td><span class="badge bg-light text-dark border">{{this.category}}</span></td>
                            <td class="fw-semibold">${{formatCurrency this.basePrice}}</td>
                            <td>
                                {{#if this.estimatedDurationMinutes}}
                                    {{this.estimatedDurationMinutes}} min
                                {{else}}
                                    <span class="text-muted">-</span>
                                {{/if}}
                            </td>
                            <td>
                                {{#if (eq this.status 'Activo')}}
                                    <span class="badge bg-success">Activo</span>
                                {{else}}
                                    <span class="badge bg-secondary">Inactivo</span>
                                {{/if}}
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a href="/services/detail/{{this.id}}" class="btn btn-outline-info" title="Ver Detalle">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a href="/services/edit/{{this.id}}" class="btn btn-outline-primary" title="Editar">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <form action="/services/delete/{{this.id}}" method="POST" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar este servicio?');">
                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-toolbox fa-2x mb-2 d-block"></i>
                                No hay servicios registrados.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
