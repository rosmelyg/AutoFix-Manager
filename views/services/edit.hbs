<div class="container-fluid pt-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h4 class="card-title fw-bold mb-0 text-dark">
                <i class="fa-solid fa-pen-to-square text-orange me-2"></i>Editar Servicio
            </h4>
        </div>
        <div class="card-body p-4">
            {{#if error}}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>{{error}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {{/if}}

            <form action="/services/edit/{{service.id}}" method="POST">
                <div class="mb-3">
                    <label for="name" class="form-label fw-semibold">Nombre del Servicio <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="name" name="name" value="{{service.name}}" required>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label fw-semibold">Descripción</label>
                    <textarea class="form-control" id="description" name="description" rows="3">{{service.description}}</textarea>
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label fw-semibold">Categoría <span class="text-danger">*</span></label>
                    <select class="form-select" id="category" name="category" required>
                        {{#each categories}}
                            <option value="{{this}}" {{#if (eq ../service.category this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="basePrice" class="form-label fw-semibold">Precio Base ($) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control" id="basePrice" name="basePrice" value="{{service.basePrice}}" required>
                    </div>

                    <div class="col-md-6">
                        <label for="estimatedDurationMinutes" class="form-label fw-semibold">Duración Estimada (min)</label>
                        <input type="number" min="1" class="form-control" id="estimatedDurationMinutes" name="estimatedDurationMinutes" value="{{service.estimatedDurationMinutes}}">
                    </div>
                </div>

                <div class="mb-4">
                    <label for="status" class="form-label fw-semibold">Estado <span class="text-danger">*</span></label>
                    <select class="form-select" id="status" name="status" required>
                        {{#each statuses}}
                            <option value="{{this}}" {{#if (eq ../service.status this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/services" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-orange px-4">Actualizar Servicio</button>
                </div>
            </form>
        </div>
    </div>
</div>
