<div class="container-fluid pt-2">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h4 class="card-title fw-bold mb-0 text-dark">
                <i class="fa-solid fa-toolbox text-orange me-2"></i>Detalle del Servicio
            </h4>
            <div>
                <a href="/services/edit/{{service.id}}" class="btn btn-sm btn-outline-primary me-2">
                    <i class="fa-solid fa-pen-to-square me-1"></i> Editar
                </a>
                <a href="/services" class="btn btn-sm btn-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Nombre del Servicio</label>
                    <p class="fs-5 fw-bold text-dark mb-0">{{service.name}}</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Categoría</label>
                    <p class="fs-5 text-dark mb-0"><span class="badge bg-light text-dark border">{{service.category}}</span></p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Precio Base</label>
                    <p class="fs-5 fw-bold text-orange mb-0">${{formatCurrency service.basePrice}}</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Duración Estimada</label>
                    <p class="fs-5 text-dark mb-0">
                        {{#if service.estimatedDurationMinutes}}
                            {{service.estimatedDurationMinutes}} minutos
                        {{else}}
                            <span class="text-muted">No especificada</span>
                        {{/if}}
                    </p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Estado</label>
                    <div>
                        {{#if (eq service.status 'Activo')}}
                            <span class="badge bg-success fs-6">Activo</span>
                        {{else}}
                            <span class="badge bg-secondary fs-6">Inactivo</span>
                        {{/if}}
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Uso en Órdenes de Trabajo</label>
                    <p class="fs-5 fw-bold text-dark mb-0">{{usageCount}}</p>
                </div>
                <div class="col-12">
                    <label class="text-muted small text-uppercase fw-bold">Descripción</label>
                    <p class="text-dark bg-light p-3 rounded mb-0">
                        {{#if service.description}}{{service.description}}{{else}}<span class="text-muted">Sin descripción</span>{{/if}}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
