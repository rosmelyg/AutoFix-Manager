<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - AutoFix Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/custom.css">
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="bg-white border-end" id="sidebar-wrapper">
            <div class="sidebar-heading text-center py-4 fs-4 fw-bold text-orange border-bottom">
                <i class="fa-solid fa-screwdriver-wrench me-2"></i>AutoFix Manager
            </div>
            <div class="list-group list-group-flush">
                <a href="/" class="list-group-item list-group-item-action py-3 {{#if activeHome}}active-orange{{/if}}">
                    <i class="fa-solid fa-chart-pie me-2"></i> Inicio
                </a>
                <a href="/brands" class="list-group-item list-group-item-action py-3 {{#if activeBrands}}active-orange{{/if}}">
                    <i class="fa-solid fa-copyright me-2"></i> Marcas
                </a>
                <a href="/vehicles" class="list-group-item list-group-item-action py-3 {{#if activeVehicles}}active-orange{{/if}}">
                    <i class="fa-solid fa-car me-2"></i> Vehículos
                </a>
                <a href="/services" class="list-group-item list-group-item-action py-3 {{#if activeServices}}active-orange{{/if}}">
                    <i class="fa-solid fa-toolbox me-2"></i> Servicios
                </a>
                <a href="/parts" class="list-group-item list-group-item-action py-3 {{#if activeParts}}active-orange{{/if}}">
                    <i class="fa-solid fa-gears me-2"></i> Piezas / Repuestos
                </a>
                <a href="/job-orders" class="list-group-item list-group-item-action py-3 {{#if activeOrders}}active-orange{{/if}}">
                    <i class="fa-solid fa-file-invoice-dollar me-2"></i> Órdenes de Trabajo
                </a>
            </div>
        </div>


            <!-- Page Content -->
        <div id="page-content-wrapper" class="flex-grow-1 d-flex flex-column" style="min-height: 100vh;">
            <main class="container-fluid px-4 pt-3 pb-4 flex-grow-1">
                {{{body}}}
            </main>

            <footer class="border-top py-3 text-center text-muted small">
                © 2026 AutoFix Manager - Todos los derechos reservados.
            </footer>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
