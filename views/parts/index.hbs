<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-gears text-orange me-2"></i>Gestión de Piezas y Repuestos</h2>
            <p class="text-muted mb-0">Controla el inventario de repuestos, costos, precios y alertas de stock.</p>
        </div>
        <a href="/parts/create" class="btn btn-orange px-4 py-2">
            <i class="fa-solid fa-plus me-1"></i> Registrar Pieza
        </a>
    </div>

    {{#if success}}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>{{success}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {{/if}}

    {{#if error}}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>{{error}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {{/if}}

    <!-- Filtros -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form action="/parts" method="GET" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">Filtrar por Categoría</label>
                    <select name="category" class="form-select form-select-sm">
                        <option value="">Todas las categorías</option>
                        {{#each categories}}
                            <option value="{{this}}" {{#if (eq ../filters.category this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Filtrar por Estado</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">Todos los estados</option>
                        {{#each statuses}}
                            <option value="{{this}}" {{#if (eq ../filters.status this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Nivel de Inventario</label>
                    <select name="inventoryLevel" class="form-select form-select-sm">
                        <option value="">Todos los niveles</option>
                        <option value="normal" {{#if (eq filters.inventoryLevel 'normal')}}selected{{/if}}>Normal</option>
                        <option value="low" {{#if (eq filters.inventoryLevel 'low')}}selected{{/if}}>Bajo inventario</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-dark w-100">
                        <i class="fa-solid fa-filter me-1"></i> Filtrar
                    </button>
                    <a href="/parts" class="btn btn-sm btn-outline-secondary" title="Limpiar Filtros">
                        <i class="fa-solid fa-arrows-rotate"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de repuestos -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Código</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th class="text-center">Stock Actual</th>
                            <th class="text-center">Stock Mínimo</th>
                            <th>Precio Venta</th>
                            <th>Estado</th>
                            <th>Nivel de Inventario</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each parts}}
                        <tr class="{{#if this.isLowStock}}table-warning{{/if}}">
                            <td class="ps-3 fw-bold text-secondary">{{this.code}}</td>
                            <td class="fw-semibold">{{this.name}}</td>
                            <td><span class="badge bg-light text-dark border">{{this.category}}</span></td>
                            <td class="text-center fw-bold {{#if this.isLowStock}}text-danger{{/if}}">{{this.stockActual}}</td>
                            <td class="text-center text-muted">{{this.stockMinimo}}</td>
                            <td class="fw-semibold">${{formatCurrency this.salePrice}}</td>
                            <td>
                                {{#if (eq this.status 'Activa')}}
                                    <span class="badge bg-success">Activa</span>
                                {{else}}
                                    <span class="badge bg-secondary">Inactiva</span>
                                {{/if}}
                            </td>
                            <td>
                                {{#if this.isLowStock}}
                                    <span class="badge bg-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i>Bajo inventario</span>
                                {{else}}
                                    <span class="badge bg-success">Normal</span>
                                {{/if}}
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a href="/parts/detail/{{this.id}}" class="btn btn-outline-info" title="Ver Detalle">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a href="/parts/edit/{{this.id}}" class="btn btn-outline-primary" title="Editar">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <form action="/parts/delete/{{this.id}}" method="POST" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar esta pieza?');">
                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-gears fa-2x mb-2 d-block"></i>
                                No hay piezas registradas.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
