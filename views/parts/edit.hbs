<div class="container-fluid pt-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h4 class="card-title fw-bold mb-0 text-dark">
                <i class="fa-solid fa-pen-to-square text-orange me-2"></i>Editar Pieza: {{part.code}}
            </h4>
        </div>
        <div class="card-body p-4">
            {{#if error}}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>{{error}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {{/if}}

            <form action="/parts/edit/{{part.id}}" method="POST" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="code" class="form-label fw-semibold">Código Interno <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="code" name="code" value="{{part.code}}" required>
                    </div>

                    <div class="col-md-6">
                        <label for="name" class="form-label fw-semibold">Nombre de la Pieza <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" name="name" value="{{part.name}}" required>
                    </div>

                    <div class="col-12">
                        <label for="description" class="form-label fw-semibold">Descripción</label>
                        <textarea class="form-control" id="description" name="description" rows="2">{{part.description}}</textarea>
                    </div>

                    <div class="col-md-6">
                        <label for="category" class="form-label fw-semibold">Categoría <span class="text-danger">*</span></label>
                        <select class="form-select" id="category" name="category" required>
                            {{#each categories}}
                                <option value="{{this}}" {{#if (eq ../part.category this)}}selected{{/if}}>{{this}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="status" class="form-label fw-semibold">Estado <span class="text-danger">*</span></label>
                        <select class="form-select" id="status" name="status" required>
                            {{#each statuses}}
                                <option value="{{this}}" {{#if (eq ../part.status this)}}selected{{/if}}>{{this}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label for="stockActual" class="form-label fw-semibold">Stock Actual <span class="text-danger">*</span></label>
                        <input type="number" min="0" class="form-control" id="stockActual" name="stockActual" value="{{part.stockActual}}" required>
                    </div>

                    <div class="col-md-3">
                        <label for="stockMinimo" class="form-label fw-semibold">Stock Mínimo <span class="text-danger">*</span></label>
                        <input type="number" min="0" class="form-control" id="stockMinimo" name="stockMinimo" value="{{part.stockMinimo}}" required>
                    </div>

                    <div class="col-md-3">
                        <label for="unitCost" class="form-label fw-semibold">Costo Unitario ($) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0" class="form-control" id="unitCost" name="unitCost" value="{{part.unitCost}}" required>
                    </div>

                    <div class="col-md-3">
                        <label for="salePrice" class="form-label fw-semibold">Precio de Venta ($) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control" id="salePrice" name="salePrice" value="{{part.salePrice}}" required>
                    </div>

                    <div class="col-12">
                        <label for="image" class="form-label fw-semibold">Imagen del Repuesto (Opcional, dejar vacío para mantener la actual)</label>
                        {{#if part.image}}
                            <div class="mb-2">
                                <img src="{{part.image}}" alt="Imagen actual" class="img-thumbnail" style="max-height: 120px;">
                            </div>
                        {{/if}}
                        <input type="file" class="form-control" id="image" name="image" accept=".jpg,.jpeg,.png,.webp">
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="/parts" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-orange px-4">Actualizar Pieza</button>
                </div>
            </form>
        </div>
    </div>
</div>
