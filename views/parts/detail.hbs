<div class="container-fluid pt-2">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h4 class="card-title fw-bold mb-0 text-dark">
                <i class="fa-solid fa-gears text-orange me-2"></i>Detalle de la Pieza: {{part.name}}
            </h4>
            <div>
                <a href="/parts/edit/{{part.id}}" class="btn btn-sm btn-outline-primary me-2">
                    <i class="fa-solid fa-pen-to-square me-1"></i> Editar
                </a>
                <a href="/parts" class="btn btn-sm btn-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                {{#if part.image}}
                <div class="col-md-4 text-center">
                    <img src="{{part.image}}" alt="{{part.name}}" class="img-fluid rounded border shadow-sm mb-2" style="max-height: 200px; object-fit: cover;">
                </div>
                {{/if}}

                <div class="{{#if part.image}}col-md-8{{else}}col-md-12{{/if}}">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase fw-bold">Código Interno</label>
                            <p class="fs-5 fw-bold text-secondary mb-0">{{part.code}}</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase fw-bold">Nombre</label>
                            <p class="fs-5 fw-bold text-dark mb-0">{{part.name}}</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase fw-bold">Categoría</label>
                            <p class="fs-5 text-dark mb-0"><span class="badge bg-light text-dark border">{{part.category}}</span></p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase fw-bold">Estado</label>
                            <div>
                                {{#if (eq part.status 'Activa')}}
                                    <span class="badge bg-success fs-6">Activa</span>
                                {{else}}
                                    <span class="badge bg-secondary fs-6">Inactiva</span>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12"><hr class="my-2"></div>

                <div class="col-md-3">
                    <label class="text-muted small text-uppercase fw-bold">Stock Actual</label>
                    <p class="fs-4 fw-bold {{#if part.isLowStock}}text-danger{{else}}text-dark{{/if}} mb-0">{{part.stockActual}}</p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small text-uppercase fw-bold">Stock Mínimo</label>
                    <p class="fs-4 fw-bold text-muted mb-0">{{part.stockMinimo}}</p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small text-uppercase fw-bold">Costo Unitario</label>
                    <p class="fs-4 fw-semibold text-dark mb-0">${{formatCurrency part.unitCost}}</p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small text-uppercase fw-bold">Precio de Venta</label>
                    <p class="fs-4 fw-bold text-orange mb-0">${{formatCurrency part.salePrice}}</p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Nivel de Inventario</label>
                    <div>
                        {{#if part.isLowStock}}
                            <span class="badge bg-danger fs-6"><i class="fa-solid fa-triangle-exclamation me-1"></i>Bajo inventario</span>
                        {{else}}
                            <span class="badge bg-success fs-6">Normal</span>
                        {{/if}}
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small text-uppercase fw-bold">Uso en Órdenes de Trabajo</label>
                    <p class="fs-5 fw-bold text-dark mb-0">{{usageCount}}</p>
                </div>

                <div class="col-12">
                    <label class="text-muted small text-uppercase fw-bold">Descripción</label>
                    <p class="text-dark bg-light p-3 rounded mb-0">
                        {{#if part.description}}{{part.description}}{{else}}<span class="text-muted">Sin descripción</span>{{/if}}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
