<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="card shadow-sm border-0 py-5">
        <div class="card-body">
            <div class="text-danger mb-3" style="font-size: 5rem;">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>
            <h2 class="fw-bold text-dark mb-3">Aviso del Sistema</h2>
            <p class="text-muted fs-5 mb-4">{{#if message}}{{message}}{{else}}Ha ocurrido un error inesperado al procesar la solicitud.{{/if}}</p>
            <div class="d-flex justify-content-center gap-2">
                <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 py-2">
                    <i class="fa-solid fa-arrow-left me-2"></i>Volver
                </a>
                <a href="/" class="btn btn-orange px-4 py-2">
                    <i class="fa-solid fa-house me-2"></i>Inicio
                </a>
            </div>
        </div>
    </div>
</div>
