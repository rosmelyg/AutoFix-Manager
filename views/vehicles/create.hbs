<div class="container-fluid pt-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h4 class="card-title fw-bold mb-0 text-dark">
                <i class="fa-solid fa-car text-orange me-2"></i>Registrar Nuevo Vehículo
            </h4>
        </div>
        <div class="card-body p-4">
            {{#if error}}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>{{error}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {{/if}}

            <form action="/vehicles/create" method="POST" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="plate" class="form-label fw-semibold">Placa / Matrícula <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="plate" name="plate" value="{{vehicle.plate}}" placeholder="Ej. A123456" required>
                    </div>

                    <div class="col-md-6">
                        <label for="brandId" class="form-label fw-semibold">Marca <span class="text-danger">*</span></label>
                        <select class="form-select" id="brandId" name="brandId" required>
                            <option value="">Seleccione una marca activa</option>
                            {{#each brands}}
                                <option value="{{this.id}}" {{#if (eq ../vehicle.brandId this.id)}}selected{{/if}}>{{this.name}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="model" class="form-label fw-semibold">Modelo <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="model" name="model" value="{{vehicle.model}}" placeholder="Ej. Corolla, Civic, Ranger" required>
                    </div>

                    <div class="col-md-3">
                        <label for="year" class="form-label fw-semibold">Año <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="year" name="year" value="{{vehicle.year}}" min="1980" placeholder="Ej. 2022" required>
                    </div>

                    <div class="col-md-3">
                        <label for="color" class="form-label fw-semibold">Color <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="color" name="color" value="{{vehicle.color}}" placeholder="Ej. Rojo, Blanco, Negro" required>
                    </div>

                    <div class="col-md-6">
                        <label for="vehicleType" class="form-label fw-semibold">Tipo de Vehículo <span class="text-danger">*</span></label>
                        <select class="form-select" id="vehicleType" name="vehicleType" required>
                            <option value="">Seleccione un tipo</option>
                            {{#each vehicleTypes}}
                                <option value="{{this}}" {{#if (eq ../vehicle.vehicleType this)}}selected{{/if}}>{{this}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="currentMileage" class="form-label fw-semibold">Kilometraje Actual <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" class="form-control" id="currentMileage" name="currentMileage" value="{{vehicle.currentMileage}}" min="0" placeholder="Ej. 45000" required>
                    </div>

                    <div class="col-12"><hr class="my-2"></div>
                    <h5 class="fw-bold text-secondary mb-0">Datos del Propietario</h5>

                    <div class="col-md-4">
                        <label for="ownerName" class="form-label fw-semibold">Nombre del Propietario <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ownerName" name="ownerName" value="{{vehicle.ownerName}}" placeholder="Nombre completo" required>
                    </div>

                    <div class="col-md-4">
                        <label for="ownerPhone" class="form-label fw-semibold">Teléfono de Contacto <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ownerPhone" name="ownerPhone" value="{{vehicle.ownerPhone}}" placeholder="Ej. 809-555-1234" required>
                    </div>

                    <div class="col-md-4">
                        <label for="ownerEmail" class="form-label fw-semibold">Correo Electrónico</label>
                        <input type="email" class="form-control" id="ownerEmail" name="ownerEmail" value="{{vehicle.ownerEmail}}" placeholder="ejemplo@correo.com">
                    </div>

                    <div class="col-12"><hr class="my-2"></div>

                    <div class="col-md-12">
                        <label for="image" class="form-label fw-semibold">Imagen Principal del Vehículo (Opcional: .jpg, .jpeg, .png, .webp)</label>
                        <input type="file" class="form-control" id="image" name="image" accept=".jpg,.jpeg,.png,.webp">
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="/vehicles" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-orange px-4">Guardar Vehículo</button>
                </div>
            </form>
        </div>
    </div>
</div>
