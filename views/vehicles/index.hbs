<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-car text-orange me-2"></i>Gestión de Vehículos</h2>
            <p class="text-muted mb-0">Administra los vehículos que ingresan y son atendidos en el taller.</p>
        </div>
        <a href="/vehicles/create" class="btn btn-orange px-4 py-2">
            <i class="fa-solid fa-plus me-1"></i> Registrar Vehículo
        </a>
    </div>

    {{#if success}}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>{{success}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {{/if}}

    {{#if error}}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>{{error}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {{/if}}

    <!-- Filtros de búsqueda -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form action="/vehicles" method="GET" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Filtrar por Marca</label>
                    <select name="brandId" class="form-select form-select-sm">
                        <option value="">Todas las marcas</option>
                        {{#each brands}}
                            <option value="{{this.id}}" {{#if (eq ../filters.brandId this.id)}}selected{{/if}}>{{this.name}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Filtrar por Estado</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">Todos los estados</option>
                        {{#each vehicleStatuses}}
                            <option value="{{this}}" {{#if (eq ../filters.status this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">Buscar por Placa</label>
                    <input type="text" name="plate" class="form-control form-control-sm" placeholder="Ej. A123456" value="{{filters.plate}}">
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-dark w-100">
                        <i class="fa-solid fa-filter me-1"></i> Filtrar
                    </button>
                    <a href="/vehicles" class="btn btn-sm btn-outline-secondary" title="Limpiar Filtros">
                        <i class="fa-solid fa-arrows-rotate"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de vehículos -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Placa</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Año</th>
                            <th>Color</th>
                            <th>Tipo</th>
                            <th>Propietario</th>
                            <th>Estado</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each vehicles}}
                        <tr>
                            <td class="ps-3 fw-bold text-orange">{{this.plate}}</td>
                            <td>{{this.Brand.name}}</td>
                            <td>{{this.model}}</td>
                            <td>{{this.year}}</td>
                            <td>{{this.color}}</td>
                            <td><span class="badge bg-light text-dark border">{{this.vehicleType}}</span></td>
                            <td>{{this.ownerName}}</td>
                            <td>
                                {{#if (eq this.status 'Registrado')}}
                                    <span class="badge bg-secondary">Registrado</span>
                                {{else if (eq this.status 'En taller')}}
                                    <span class="badge bg-warning text-dark">En taller</span>
                                {{else if (eq this.status 'Fuera del taller')}}
                                    <span class="badge bg-success">Fuera del taller</span>
                                {{else}}
                                    <span class="badge bg-danger">Inactivo</span>
                                {{/if}}
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a href="/vehicles/detail/{{this.id}}" class="btn btn-outline-info" title="Ver Detalle">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a href="/vehicles/edit/{{this.id}}" class="btn btn-outline-primary" title="Editar">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <form action="/vehicles/delete/{{this.id}}" method="POST" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar este vehículo?');">
                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-car-side fa-2x mb-2 d-block"></i>
                                No hay vehículos registrados.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
