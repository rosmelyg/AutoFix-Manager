<div class="container-fluid pt-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h4 class="card-title fw-bold mb-0 text-dark">
                <i class="fa-solid fa-pen-to-square text-orange me-2"></i>Editar Orden de Trabajo #{{order.orderNumber}}
            </h4>
            <a href="/job-orders/detail/{{order.id}}" class="btn btn-sm btn-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i> Volver a Detalle
            </a>
        </div>
        <div class="card-body p-4">
            {{#if error}}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>{{error}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {{/if}}

            <form action="/job-orders/edit/{{order.id}}" method="POST">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted">Número de Orden</label>
                        <input type="text" class="form-control bg-light" value="{{order.orderNumber}}" disabled>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted">Vehículo Asociado</label>
                        <input type="text" class="form-control bg-light" value="{{order.Vehicle.plate}} - {{order.Vehicle.Brand.name}} {{order.Vehicle.model}}" disabled>
                    </div>

                    <div class="col-md-4">
                        <label for="receptionDate" class="form-label fw-semibold">Fecha de Recepción <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="receptionDate" name="receptionDate" value="{{order.receptionDate}}" required>
                    </div>

                    <div class="col-md-4">
                        <label for="estimatedDeliveryDate" class="form-label fw-semibold">Fecha Estimada de Entrega</label>
                        <input type="date" class="form-control" id="estimatedDeliveryDate" name="estimatedDeliveryDate" value="{{order.estimatedDeliveryDate}}">
                    </div>

                    <div class="col-md-4">
                        <label for="entryMileage" class="form-label fw-semibold">Kilometraje de Entrada <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0" class="form-control" id="entryMileage" name="entryMileage" value="{{order.entryMileage}}" required>
                    </div>

                    <div class="col-12">
                        <label for="problemDescription" class="form-label fw-semibold">Descripción del Problema <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="problemDescription" name="problemDescription" rows="3" required>{{order.problemDescription}}</textarea>
                    </div>

                    <div class="col-12">
                        <label for="initialDiagnosis" class="form-label fw-semibold">Diagnóstico Inicial</label>
                        <textarea class="form-control" id="initialDiagnosis" name="initialDiagnosis" rows="2">{{order.initialDiagnosis}}</textarea>
                    </div>

                    <div class="col-12">
                        <label for="observations" class="form-label fw-semibold">Observaciones</label>
                        <textarea class="form-control" id="observations" name="observations" rows="2">{{order.observations}}</textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="/job-orders/detail/{{order.id}}" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-orange px-4">Actualizar Datos Generales</button>
                </div>
            </form>
        </div>
    </div>
</div>
